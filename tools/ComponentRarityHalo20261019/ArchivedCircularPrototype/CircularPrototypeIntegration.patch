+        // Keep the rarity treatment behind the artwork so painted details and
+        // existing hit targets remain unchanged at every icon size.
+        private ComponentRarityHaloGraphic CreateComponentRarityHalo(string name, Transform parent,
+            ComponentArtEntry entry, Vector2 size, Vector2 position, bool subdued = false)
+        {
+            RectTransform rect = CreateRect(name, parent, size, position);
+            ComponentRarityHaloGraphic halo = rect.gameObject.AddComponent<ComponentRarityHaloGraphic>();
+            halo.Configure(entry.Rarity, subdued);
+            return halo;
+        }
+
+        private RawImage CreateComponentIcon(string name, Transform parent, ComponentArtEntry entry,
+            Vector2 position, float size, bool subdued = false)
+        {
+            ItemIconArt art = ItemIconCatalog.ForComponent(entry);
+            if (art.IsAvailable)
+                CreateComponentRarityHalo(name + " Rarity Halo", parent, entry,
+                    Vector2.one * (size * 1.04f), position, subdued);
+            return CreateItemIcon(name, parent, art, position, size);
+        }
+
