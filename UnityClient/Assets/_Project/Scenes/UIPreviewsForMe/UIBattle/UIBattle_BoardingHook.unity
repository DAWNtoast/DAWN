    m_LineSpacing: 1
  m_Text: "\u5F53\u524D\u80FD\u91CF 1\uFF1D\u57FA\u7840 1\uFF0B\u672C\u56DE\u5408\u5DF2\u7528
    0 \u6B21\n\u540C\u540D\u724C\u6BCF\u6B21\u6210\u529F\u6253\u51FA\u540E\u8D39\u7528
    +1\uFF0C\u526F\u672C\u5171\u4EAB\uFF1B\n\u4E0B\u56DE\u5408\u6216\u5207\u6362\u9636\u6BB5\u6062\u590D\u57FA\u7840\u8D39\u7528\u3002\n\n\u5F53\u524D
    10 \u540D\u666E\u901A\u6C34\u624B \xB7 \u63A5\u8237\u6548\u679C 35.7%\uFF08\u4EE5
    28 \u4EBA\u4E3A\u57FA\u51C6\uFF0C\u8303\u56F4 30%\uFF5E160%\uFF09\n\u8239\u5458\u4F24\u5BB3
    2\uFF1B\n\u683C\u6321 +1\u3002\n\n<color=#5C3A0C>\u80FD\u91CF</color>\u3000\u672C\u56DE\u5408\u6253\u51FA\u5361\u724C\u7684\u884C\u52A8\u70B9\u3002\n<color=#6B251C>\u767D\u5203</color>\u3000\u524A\u51CF\u8239\u5458\u751F\u547D\uFF0C\u5F52\u96F6\u5373\u53EF\u593A\u8239\u3002\n<color=#154C46>\u683C\u6321</color>\u3000\u672C\u56DE\u5408\u4F18\u5148\u62B5\u6D88\u654C\u65B9\u653B\u51FB\u3002"
