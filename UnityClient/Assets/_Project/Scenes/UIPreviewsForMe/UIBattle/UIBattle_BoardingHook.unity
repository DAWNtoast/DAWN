    28 \u4EBA\u4E3A\u57FA\u51C6\uFF0C\u8303\u56F4 30%\uFF5E160%\uFF09\n\u683C\u6321
    +1\uFF1B\n\u62BD 2 \u5F20\u5F53\u524D\u9636\u6BB5\u724C\u3002\n\n<color=#5C3A0C>\u80FD\u91CF</color>\u3000\u672C\u56DE\u5408\u6253\u51FA\u5361\u724C\u7684\u884C\u52A8\u70B9\u3002\n<color=#154C46>\u683C\u6321</color>\u3000\u672C\u56DE\u5408\u4F18\u5148\u62B5\u6D88\u654C\u65B9\u653B\u51FB\u3002\n<color=#5C3A0C>\u62BD\u724C</color>\u3000\u7ACB\u5373\u4ECE\u724C\u5806\u8865\u5145\u624B\u724C\u3002"
