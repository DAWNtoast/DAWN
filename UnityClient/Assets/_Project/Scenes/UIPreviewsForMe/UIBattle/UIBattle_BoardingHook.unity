    28 \u4EBA\u4E3A\u57FA\u51C6\uFF0C\u8303\u56F4 30%\uFF5E160%\uFF09\n\u8239\u5458\u4F24\u5BB3
    6\u3002\n\n<color=#5C3A0C>\u80FD\u91CF</color>\u3000\u672C\u56DE\u5408\u6253\u51FA\u5361\u724C\u7684\u884C\u52A8\u70B9\u3002\n<color=#6B251C>\u767D\u5203</color>\u3000\u524A\u51CF\u8239\u5458\u751F\u547D\uFF0C\u5F52\u96F6\u5373\u53EF\u593A\u8239\u3002"
